# Optional heartbeat + audio media lookup. Empty means local-only dashboard.
DATABASE_URL=mongodb://localhost:27017/avxtube
STORAGE_ENCRYPTION_KEY=
# Managed Python (.venv/) and model (models/) always live beside windows.exe / linux.
# WORK_DIR=D:/subtitle-work
# Dashboard binds to loopback only. Leave DATABASE_URL empty for local-only use.
# DASHBOARD_ADDR=127.0.0.1:8887
# MOSS_BASE_PYTHON=C:/Python312/python.exe
# MOSS_TORCH_INDEX=https://download.pytorch.org/whl/cu130
# MOSS_MODEL_REVISION=main
# Claim production subtitle jobs and upload completed subtitles.
SUBTITLE_QUEUE_ENABLED=true
